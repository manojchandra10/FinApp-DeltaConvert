# Template for .env (leading dot, no extension). Never commit .env, and
# never reuse a value between your laptop and a server.
#
# On a laptop you do not need this file: dev.ps1 writes a .env with random
# secrets the first time it runs.
#
# On a server, copy this file to .env and fill in the two empty values.
# Use hex strings: they contain no characters that need escaping in the
# database URL. Generate each one with
#   openssl rand -hex 32
# or, in PowerShell:
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); -join ($b | ForEach-Object { $_.ToString('x2') })

POSTGRES_USER=deltaconvert
# Required. Compose refuses to start while this is empty.
POSTGRES_PASSWORD=
POSTGRES_DB=deltaconvert

# Guards the daily audit-resolve call. Required for the audit: 32 or more
# random characters. While it is empty, short or a template value, the
# endpoint refuses every request (the API logs a warning at start-up).
ADMIN_SECRET=

# Used for the CORS origins in production.
DOMAIN=deltaconvert.com

# Product name shown in the API title.
APP_BRAND=DeltaConvert
