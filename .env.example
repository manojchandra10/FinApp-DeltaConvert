# Rename this file to .env (leading dot, no extension) before running.
# On Windows, File Explorer will not create a name starting with a dot,
# so use VS Code or PowerShell:
#   Rename-Item .env.example .env
#
# These values are fine for local testing only. The server keeps its own
# .env with different secrets; never copy this one to production and
# never commit either version.

POSTGRES_USER=deltaconvert
POSTGRES_PASSWORD=local_dev_password_change_me
POSTGRES_DB=deltaconvert

# Guards the manual audit-resolve endpoint.
ADMIN_SECRET=local_dev_admin_token_change_me

# Used for CORS origins in production. Harmless locally.
DOMAIN=deltaconvert.com

# Product name shown in the API title.
APP_BRAND=DeltaConvert
